# =============================================================================
#  UTRADEBOT — Telegram Account Sale Escrow
#  - Holds traded account sessions. Never commit .env. chmod 600.
# =============================================================================

# Bot token from @BotFather for the trade bot (separate from escrow main bot)
UTRADE_BOT_TOKEN=123456:ABC...

# Telegram API credentials (same as ubot, from https://my.telegram.org)
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# Admin Telegram IDs (comma-separated) for override/cancel
ADMIN_TELEGRAM_IDS=111111,222222

# Database (shared Postgres)
DATABASE_URL=postgres://escrow:escrow_password@postgres:5432/escrow

# Encryption key for sessions at rest (32 bytes hex, 64 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional: internal API port (health, metrics) — not Telegram polling
PORT=3003
UTRADE_API_KEY=change_me_32plus_random

# Logging
LOG_LEVEL=info
