# =============================================================================
#  UBOT — Telegram Userbot (GramJS)
#  - Holds user account session. Never commit this file. chmod 600.
# =============================================================================

# Telegram API credentials from https://my.telegram.org (required)
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# Userbot session (StringSession). Generate via: npm run login
# Store encrypted: leave empty to login interactively on first run if ENCRYPTION_KEY set
UBOT_SESSION_STRING=

# Phone number for initial login (E.164, e.g. +1234567890) — used by login script
UBOT_PHONE=

# 2FA password (if account has 2FA). Stored in env, never logged.
TWO_FA_PASSWORD=

# Encryption key for session at rest (32 bytes hex, 64 chars). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Internal API
PORT=3002
UBOT_API_KEY=change_me_32plus_random_for_internal_auth

# Optional: Postgres for session persistence (alternative to file)
DATABASE_URL=postgres://escrow:escrow_password@postgres:5432/escrow

# Logging
LOG_LEVEL=info
